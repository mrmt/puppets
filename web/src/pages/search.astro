---
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { getArtists, withArtistLabels } from "../utils/artists";

const query = Astro.url.searchParams.get("q")?.trim() || "";

const { entries: allPosts } = await getEmDashCollection("posts", { orderBy: { published_at: "desc" } });

/** Portable Text からテキストだけを取り出す (_type や _key に一致させないため) */
function extractText(value: unknown): string {
	if (!Array.isArray(value)) return "";
	return value
		.flatMap((block) => (Array.isArray(block?.children) ? block.children : []))
		.map((child: { text?: unknown }) => (typeof child.text === "string" ? child.text : ""))
		.join(" ");
}

const q = query.toLowerCase();
const results = q
	? allPosts.filter((p) =>
			[p.data.title, p.data.excerpt, extractText(p.data.content)].some((s) => (s || "").toLowerCase().includes(q)),
		)
	: [];
const { artists } = await getArtists();
const cards = await withArtistLabels(results, artists);
---

<Base title={query ? `Search: ${query}` : "Search"} robots="noindex">
	<section class="section">
		<div class="container">
			<p class="eyebrow">Search</p>
			<form method="get" action="/search" class="search-form" role="search">
				<label for="q" class="visually-hidden">検索語</label>
				<input id="q" type="search" name="q" value={query} placeholder="Search posts…" autofocus />
				<button type="submit">Search</button>
			</form>
			{
				query && (
					<p class="meta summary">
						{results.length} result{results.length === 1 ? "" : "s"} for “{query}”
					</p>
				)
			}
			<ul class="card-grid">
				{cards.map(({ post, label }) => <PostCard post={post} label={label} />)}
			</ul>
		</div>
	</section>
</Base>

<style>
	.search-form {
		display: flex;
		gap: 8px;
		max-width: 640px;
		margin-bottom: 20px;
	}

	.search-form input {
		flex: 1;
		min-width: 0;
		font: inherit;
		font-size: 1.2rem;
		color: var(--color-text);
		background: var(--color-bg-subtle);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		padding: 12px 14px;
	}

	.search-form button {
		font-family: var(--font-mono), monospace;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		background: var(--color-accent);
		color: var(--color-on-accent);
		border: 0;
		border-radius: var(--radius);
		padding: 0 18px;
		cursor: pointer;
	}

	.summary {
		margin-bottom: 32px;
	}
</style>
