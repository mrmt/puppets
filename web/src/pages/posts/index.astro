---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { getArtists, withArtistLabels } from "../../utils/artists";
import { firstOwnImage } from "../../utils/og-image";

const PER_PAGE = 24;
const page = Math.max(1, Number.parseInt(Astro.url.searchParams.get("page") ?? "1", 10) || 1);

const { entries, hasMore, cacheHint } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: PER_PAGE,
	offset: (page - 1) * PER_PAGE,
});
Astro.cache.set(cacheHint);

if (entries.length === 0 && page > 1) {
	return Astro.rewrite("/404");
}

const { artists } = await getArtists();
const cards = await withArtistLabels(entries, artists);
---

<Base
	title={page > 1 ? `Posts — page ${page}` : "Posts"}
	description="puppets records の投稿一覧"
	image={firstOwnImage(entries, Astro.url.origin)}
>
	<section class="section">
		<div class="container">
			<p class="eyebrow">Archive{page > 1 && ` / page ${page}`}</p>
			<h1 class="display page-title">Posts</h1>
			<ul class="card-grid">
				{cards.map(({ post, label }) => <PostCard post={post} label={label} />)}
			</ul>
			<nav class="pagination meta" aria-label="ページ送り">
				<span>{page > 1 && <a href={page === 2 ? "/posts" : `/posts?page=${page - 1}`}>← Newer</a>}</span>
				<span>{hasMore && <a href={`/posts?page=${page + 1}`}>Older →</a>}</span>
			</nav>
		</div>
	</section>
</Base>

<style>
	.page-title {
		font-size: clamp(2.4rem, 7vw, 4.5rem);
		margin-bottom: 40px;
	}
</style>
