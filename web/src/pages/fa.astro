---
/**
 * Fourier Analyze 2025 告知ページ (旧 Tumblr カスタムページ /fa を移植)
 * 元: content/custom-pages/fa/index.html
 */
import Base from "../layouts/Base.astro";

const MAP_URL = "https://maps.app.goo.gl/bjATjc71rLn7AgTg6";
---

<Base
	title="Fourier Analyze 2025"
	description="puppets records のライブイベント Fourier Analyze が約 30 年ぶりに復活。2025.3.16 広尾 Tomo,K'yon'S'"
	image={new URL("/fa/cover.jpg", Astro.url.origin).href}
>
	<section class="fa-hero">
		<div class="container">
			<p class="fa-intro">For the first time in nearly 30 years,<br />we puppets records bringing back the live event</p>
			<img class="fa-cover" src="/fa/cover.jpg" alt="Fourier Analyze" width="500" />
			<h1 class="fa-title">Fourier Analyze</h1>
			<p class="fa-date">2025.3.16</p>
			<p class="fa-time">Open 13:00, Start 13:30</p>
			<p class="fa-venue">Hiroo Tomo,K'yon'S'</p>
			<p class="fa-address">5-12-3 Hiroo, Shibuya-ku, Tokyo (<a href={MAP_URL} rel="noopener">Google Map</a>)</p>
			<p class="fa-address">2-minute walk from Hiroo Station<br />(Tokyo Metro Hibiya Line)</p>
		</div>
	</section>

	<div class="container fa-body">
		<section class="fa-row">
			<div>
				<h2>Rebirth</h2>
				<p>30年近くのときを経て, ライブイベントFourier Analyzeを再生復活します.</p>
			</div>
			<img src="/fa/rebirth.png" alt="" loading="lazy" />
		</section>

		<section class="fa-row fa-row--reverse">
			<div>
				<h2><a href="/artists/diastereomer">Diastereomer</a></h2>
				<p>
					1986年に東京で結成されたニューウェーブの2人組バンド. 1989年に自主制作シングルMothersunを200枚限定でリリース.
					時を経て2018年にはBitter Lake Recordingsから未発表のスタジオ録音やライブ音源を収録したアルバム<a
						href="https://bitterlakerecordings.bandcamp.com/album/ignition-advancer"
						rel="noopener">Ignition Advancer</a
					>がリリースされ, 翌年には<a
						href="https://bitterlakerecordings.bandcamp.com/album/diastereomer-demo-and-live-tracks-vol-1"
						rel="noopener">Demo And Live Tracks, Vol. 1</a
					>もリリースされた. 今回Diastereomerとしては約35年振りにライブを行う.
				</p>
			</div>
			<img src="/fa/diastereomer.jpg" alt="Diastereomer" loading="lazy" />
		</section>

		<section class="fa-row">
			<div>
				<h2><a href="/artists/sect-commune">Sect Commune</a></h2>
				<p>
					1987年に東京で結成されたエレクトロニック・ポップ/ロックユニット. 2019年にはミニアルバム<a
						href="https://open.spotify.com/intl-ja/album/0WLfM9FNZhJ5znKOqTkdhl"
						rel="noopener">Six Ambient Tracks</a
					>をリリース. 彼らの音楽は、エレクトロニカやテクノの要素を取り入れた独自のスタイルが特徴である.
				</p>
				<p><a href="https://sect-commune.com" rel="noopener">Sect Commune Official Site</a></p>
			</div>
			<img src="/fa/sect-commune.jpg" alt="Sect Commune" loading="lazy" />
		</section>

		<p class="fa-note">
			当日はDiastereomer, Sect Commune, そして全員によるカバーセッションをお楽しみいただけます.<br />
			ぜひお誘い合わせのうえお越しください.
		</p>

		<section class="fa-row fa-access">
			<div>
				<h2>Venue / アクセス</h2>
				<p class="fa-access-venue">広尾Tomo,K'yon'S'</p>
				<p>東京都渋谷区広尾5-12-3<br />半地下フロア<br />(<a href={MAP_URL} rel="noopener">Google Map</a>)</p>
				<p>東京メトロ日比谷線 広尾駅徒歩2分</p>
				<p>2025/3/16<br />Open 13:00, Start 13:30<br />1,000JPY + 1 Drink Order</p>
			</div>
			<img src="/fa/venue.jpg" alt="広尾Tomo,K'yon'S'" loading="lazy" />
		</section>

		<p class="fa-outro">Love to see you there!</p>
	</div>
</Base>

<style>
	.fa-hero {
		text-align: center;
		padding-block: 64px 56px;
		background: #000;
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.fa-intro {
		color: var(--color-text);
		margin: 0 0 32px;
	}

	.fa-cover {
		margin: 0 auto;
	}

	.fa-title {
		font-family: var(--font-display);
		font-weight: 500;
		color: #008f8c;
		font-size: clamp(2.6rem, 9vw, 4rem);
		line-height: 1;
		margin: 48px 0;
	}

	.fa-date {
		font-family: var(--font-display);
		font-size: 2rem;
		margin: 0 0 8px;
	}

	.fa-time {
		font-size: 1.15rem;
		margin: 0 0 32px;
	}

	.fa-venue {
		font-size: 1.4rem;
		margin: 0 0 8px;
	}

	.fa-address {
		color: var(--color-text-secondary);
		margin: 0;
	}

	.fa-hero a,
	.fa-body a {
		color: var(--color-text);
		text-decoration-color: #008f8c;
		text-underline-offset: 3px;
	}

	.fa-body {
		max-width: 960px;
		padding-block: 48px;
	}

	.fa-row {
		display: grid;
		grid-template-columns: 1fr minmax(0, 40%);
		align-items: center;
		gap: 32px;
		padding-block: 32px;
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.fa-row--reverse > img {
		order: -1;
	}

	.fa-row--reverse {
		grid-template-columns: minmax(0, 40%) 1fr;
	}

	.fa-row img {
		border-radius: 10px;
		width: 100%;
	}

	.fa-row h2 {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 1.8rem;
		line-height: 1.3;
		margin: 0 0 12px;
	}

	.fa-row h2 a {
		text-decoration: none;
	}

	.fa-row p {
		color: var(--color-text-secondary);
		margin: 0 0 12px;
	}

	.fa-note {
		text-align: center;
		padding-block: 40px;
		margin: 0;
	}

	.fa-access {
		background: #000;
		padding: 32px;
		border-radius: var(--radius);
		border-bottom: 0;
	}

	.fa-access-venue {
		font-size: 1.3rem;
		color: var(--color-text) !important;
	}

	.fa-access img {
		border-radius: 0;
	}

	.fa-outro {
		font-family: var(--font-display);
		font-size: clamp(1.8rem, 5vw, 2.6rem);
		text-align: center;
		margin: 56px 0 0;
	}

	@media (max-width: 640px) {
		.fa-row,
		.fa-row--reverse {
			grid-template-columns: 1fr;
		}

		.fa-row--reverse > img {
			order: 0;
		}
	}
</style>
