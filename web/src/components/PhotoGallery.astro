---
import type { Photo } from "../utils/media";

interface Props {
	photos: Photo[];
}

const { photos } = Astro.props;
---

{
	photos.length > 0 && (
		<div class:list={["gallery", photos.length > 1 && "gallery--multi"]}>
			{photos.map((photo) => (
				<a href={photo.url} class="gallery-item">
					<img src={photo.url} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
				</a>
			))}
		</div>
	)
}

<style>
	.gallery {
		display: grid;
		gap: 12px;
	}

	.gallery img {
		width: 100%;
		border-radius: var(--radius);
		background: var(--color-surface);
	}
</style>
