---
/**
 * Portable Text の embed ブロック。
 * 対応サービス (YouTube / Spotify / Apple Music) はプレイヤーを埋め込み、それ以外はリンクにする
 */
import { toEmbed } from "../utils/embed";

interface Props {
	node: { _type: "embed"; _key: string; url: string };
}

const { url } = Astro.props.node;
const target = toEmbed(url);
---

{
	target?.kind === "video" ? (
		<div class="embed embed--video">
			<iframe src={target.src} title="YouTube" loading="lazy" allowfullscreen />
		</div>
	) : target ? (
		<div class="embed">
			<iframe
				src={target.src}
				height={target.height}
				title={new URL(target.src).hostname}
				loading="lazy"
				allow="autoplay *; encrypted-media *; fullscreen *; clipboard-write"
			/>
		</div>
	) : (
		<p>
			<a href={url} rel="noopener">{url}</a>
		</p>
	)
}

<style>
	.embed {
		margin: 1.4em 0;
		max-width: 660px;
	}

	.embed iframe {
		width: 100%;
		border: 0;
		border-radius: 12px;
		display: block;
	}

	.embed--video {
		aspect-ratio: 16 / 9;
		max-width: none;
	}

	.embed--video iframe {
		height: 100%;
	}
</style>
